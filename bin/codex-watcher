#!/usr/bin/env python3
from __future__ import annotations

import argparse
import glob
import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, Iterable, List, Tuple

STATE_VERSION = 1
DEFAULT_POLL_SECONDS = 2.0
MAX_NOTIFIED_TURN_IDS = 2000


def expand_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def default_codex_home() -> Path:
    return Path.home() / ".codex"


def default_state_path() -> Path:
    return Path.home() / ".local" / "state" / "codex-notifier" / "state.json"


def default_notify_command() -> Path:
    return Path.home() / ".local" / "bin" / "notify-done"


def load_state(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {
            "version": STATE_VERSION,
            "initialized_at": time.time(),
            "files": {},
            "notified_turn_ids": [],
        }

    try:
        with path.open("r", encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, json.JSONDecodeError):
        backup = path.with_suffix(path.suffix + ".bad")
        try:
            path.rename(backup)
        except OSError:
            pass
        return {
            "version": STATE_VERSION,
            "initialized_at": time.time(),
            "files": {},
            "notified_turn_ids": [],
        }

    state.setdefault("version", STATE_VERSION)
    state.setdefault("initialized_at", time.time())
    state.setdefault("files", {})
    state.setdefault("notified_turn_ids", [])
    return state


def save_state(path: Path, state: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w", encoding="utf-8") as handle:
        json.dump(state, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
    tmp_path.replace(path)


def session_files(codex_home: Path) -> List[Path]:
    pattern = str(codex_home / "sessions" / "**" / "*.jsonl")
    return [Path(path) for path in sorted(glob.glob(pattern, recursive=True))]


def baseline_existing_files(state: Dict[str, Any], files: Iterable[Path]) -> None:
    tracked = state.setdefault("files", {})
    for path in files:
        try:
            stat = path.stat()
        except OSError:
            continue
        tracked[str(path)] = {
            "offset": stat.st_size,
            "size": stat.st_size,
            "mtime": stat.st_mtime,
        }


def complete_lines(path: Path, offset: int) -> Tuple[List[bytes], int]:
    try:
        with path.open("rb") as handle:
            handle.seek(offset)
            data = handle.read()
    except OSError:
        return [], offset

    if not data:
        return [], offset

    if data.endswith(b"\n"):
        complete = data
        new_offset = offset + len(data)
    else:
        last_newline = data.rfind(b"\n")
        if last_newline < 0:
            return [], offset
        complete = data[: last_newline + 1]
        new_offset = offset + last_newline + 1

    return complete.splitlines(), new_offset


def task_complete_event(line: bytes) -> Tuple[str | None, Dict[str, Any] | None]:
    try:
        event = json.loads(line.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None, None

    if event.get("type") != "event_msg":
        return None, None

    payload = event.get("payload")
    if not isinstance(payload, dict) or payload.get("type") != "task_complete":
        return None, None

    turn_id = payload.get("turn_id")
    if not isinstance(turn_id, str) or not turn_id:
        turn_id = f"{event.get('timestamp', 'unknown')}:{payload.get('completed_at', 'unknown')}"
    return turn_id, payload


def trim_notified(state: Dict[str, Any]) -> None:
    turn_ids = state.get("notified_turn_ids", [])
    if len(turn_ids) > MAX_NOTIFIED_TURN_IDS:
        state["notified_turn_ids"] = turn_ids[-MAX_NOTIFIED_TURN_IDS:]


def notify(args: argparse.Namespace, turn_id: str, payload: Dict[str, Any]) -> bool:
    duration_ms = payload.get("duration_ms")
    if isinstance(duration_ms, int) and duration_ms > 0:
        seconds = max(1, round(duration_ms / 1000))
        message = f"Codex task complete ({seconds}s)"
    else:
        message = "Codex task complete"

    if args.dry_run:
        print(f"dry-run: would notify turn_id={turn_id} message={message}", flush=True)
        return True

    command = [str(args.notify_command), message]
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=15,
        )
    except subprocess.TimeoutExpired:
        print(
            f"codex-watcher: notify command timed out for turn_id={turn_id}",
            file=sys.stderr,
            flush=True,
        )
        return False
    except OSError as exc:
        print(f"codex-watcher: failed to run notify command: {exc}", file=sys.stderr, flush=True)
        return False

    if result.stdout:
        print(result.stdout.rstrip(), flush=True)
    if result.stderr:
        print(result.stderr.rstrip(), file=sys.stderr, flush=True)

    if result.returncode != 0:
        print(
            f"codex-watcher: notify command failed with exit code {result.returncode} for turn_id={turn_id}",
            file=sys.stderr,
            flush=True,
        )
        return False

    print(f"codex-watcher: notified turn_id={turn_id}", flush=True)
    return True


def scan_once(args: argparse.Namespace, state: Dict[str, Any]) -> int:
    tracked = state.setdefault("files", {})
    notified_ids = set(state.setdefault("notified_turn_ids", []))
    notifications = 0
    initialized_at = float(state.get("initialized_at", time.time()))

    for path in session_files(args.codex_home):
        path_key = str(path)
        try:
            stat = path.stat()
        except OSError:
            continue

        if path_key not in tracked:
            start_at_beginning = stat.st_mtime >= initialized_at - 5
            tracked[path_key] = {
                "offset": 0 if start_at_beginning else stat.st_size,
                "size": stat.st_size,
                "mtime": stat.st_mtime,
            }

        file_state = tracked[path_key]
        offset = int(file_state.get("offset", 0))
        if stat.st_size < offset:
            offset = 0

        lines, new_offset = complete_lines(path, offset)
        for line in lines:
            turn_id, payload = task_complete_event(line)
            if turn_id is None or payload is None or turn_id in notified_ids:
                continue
            if not notify(args, turn_id, payload):
                continue
            state["notified_turn_ids"].append(turn_id)
            notified_ids.add(turn_id)
            notifications += 1

        file_state["offset"] = new_offset
        file_state["size"] = stat.st_size
        file_state["mtime"] = stat.st_mtime

    trim_notified(state)
    return notifications


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Watch Codex sessions and notify on task completion.")
    parser.add_argument("--codex-home", type=expand_path, default=default_codex_home())
    parser.add_argument("--state", type=expand_path, default=default_state_path())
    parser.add_argument("--notify-command", type=expand_path, default=default_notify_command())
    parser.add_argument("--poll", type=float, default=DEFAULT_POLL_SECONDS)
    parser.add_argument("--once", action="store_true", help="Scan once and exit.")
    parser.add_argument("--dry-run", action="store_true", help="Print notifications instead of running notify-done.")
    parser.add_argument(
        "--no-baseline",
        action="store_true",
        help="On a fresh state file, scan existing files from the beginning.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    state_existed = args.state.exists()
    state = load_state(args.state)

    if not state_existed and not args.no_baseline:
        baseline_existing_files(state, session_files(args.codex_home))
        save_state(args.state, state)
        print("codex-watcher: initialized baseline", flush=True)

    while True:
        scan_once(args, state)
        save_state(args.state, state)
        if args.once:
            return 0
        time.sleep(max(0.2, args.poll))


if __name__ == "__main__":
    raise SystemExit(main())
